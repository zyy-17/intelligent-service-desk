# FastAPI AI 服务环境变量配置（复制为 .env 后填写）
# 不提交到 Git

# 服务监听端口
AI_SERVICE_PORT=8000

# 云端大模型（OpenAI 兼容接口）
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.3

# Redis（会话存储；不可用时自动降级为进程内存存储）
REDIS_HOST=192.168.100.128
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_KEY_PREFIX=isd:ai
SESSION_TTL_SECONDS=604800
SESSION_MAX_MESSAGES=100
