# FastAPI AI 服务环境变量配置（复制为 .env 后填写）
# 不提交到 Git

# 服务监听端口（python main.py 与 uvicorn 共用）
AI_SERVICE_PORT=8000
# 监听地址（仅 python main.py 使用）
AI_HOST=0.0.0.0
# 热重载：开发时设为 true，改代码自动重启
AI_RELOAD=false

# ============ 云端大模型（OpenAI 兼容接口，优先级最高）============
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
# 单模型（AI_MODELS 为空时生效）
AI_MODEL=deepseek-chat
# 候选模型列表（逗号分隔，越靠前越优先）：第一个失败自动换下一个
# 例：AI_MODELS=deepseek-chat,qwen-plus,glm-4
AI_MODELS=
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.3

# ============ 本地 Ollama 兜底（云端不可用时接管）============
# 关掉则云端失败后直接降级到本地知识库检索
OLLAMA_CHAT_ENABLED=true
# 必须是 /v1 结尾的 OpenAI 兼容地址
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
# 候选模型列表（逗号分隔，越靠前越优先；前一个失败自动换下一个）
# 注意不要用 OLLAMA_MODELS，那是 Ollama 官方的「模型文件目录」变量
OLLAMA_CHAT_MODELS=qwen2.5-coder:7b,deepseek-r1:1.5b
# 首次加载 7B 模型较慢，超时给宽一点
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.3

# AI 角色设定（写进系统提示词，改这里就能换人设，不需要改代码）
AI_ASSISTANT_NAME=小智
AI_COMPANY_NAME=智能服务台
AI_TONE=亲切、专业、有耐心，像真人客服一样自然沟通
AI_ANSWER_MAX_CHARS=200

# 问答策略
KNOWLEDGE_TOP_K=5
HISTORY_WINDOW=8
# 向量检索的余弦相似度阈值：低于该值视为「知识库没有可靠依据」
RETRIEVAL_MIN_SCORE=0.10
# 单篇知识正文拼进上下文的字数上限
KNOWLEDGE_CONTEXT_CHARS=700

# Redis（会话存储；不可用时自动降级为进程内存存储）
REDIS_HOST=192.168.100.128
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_KEY_PREFIX=isd:ai
SESSION_TTL_SECONDS=604800
SESSION_MAX_MESSAGES=100
