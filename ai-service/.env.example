# FastAPI AI 服务环境变量配置（复制为 .env 后填写）
# 不提交到 Git

# 服务监听端口（python main.py 与 uvicorn 共用）
AI_SERVICE_PORT=8000
# 监听地址（仅 python main.py 使用）
AI_HOST=0.0.0.0
# 热重载：开发时设为 true，改代码自动重启
AI_RELOAD=false

# 云端大模型（OpenAI 兼容接口）
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.3

# AI 角色设定（写进系统提示词，改这里就能换人设，不需要改代码）
AI_ASSISTANT_NAME=小智
AI_COMPANY_NAME=智能服务台
AI_TONE=亲切、专业、有耐心，像真人客服一样自然沟通
AI_ANSWER_MAX_CHARS=200

# 问答策略
KNOWLEDGE_TOP_K=5
HISTORY_WINDOW=8

# Redis（会话存储；不可用时自动降级为进程内存存储）
REDIS_HOST=192.168.100.128
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_KEY_PREFIX=isd:ai
SESSION_TTL_SECONDS=604800
SESSION_MAX_MESSAGES=100
